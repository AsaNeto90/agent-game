# Your Convex deployment URL (from `npx convex dev` / dashboard)
CONVEX_URL=https://your-project.convex.cloud
# Agent to run the demo dive with (created via agents:compile once)
AGENT_ID=
# Dive zone for the demo
ZONE_ID=tide-district

# Brain: mock (default, $0, deterministic) | gemini | openai-compatible
# NOTE: this is the PROVIDER, not the model — use exactly "gemini" here,
# and put the model name in MIND_MODEL below.
MIND_PROVIDER=mock
# For gemini: free key from https://aistudio.google.com/apikey (no credit card,
# ~1.5k requests/day on the free tier — plenty for dives)
GEMINI_API_KEY=
# Optional overrides (defaults already target Gemini's OpenAI-compatible endpoint)
# MIND_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MIND_MODEL=gemini-3.8-flash
# For openai-compatible: MIND_BASE_URL required; MIND_API_KEY only if the
# endpoint needs one. Local Ollama needs NO key — $0, no rate limits:
#   MIND_PROVIDER=openai-compatible
#   MIND_BASE_URL=http://localhost:11434/v1
#   MIND_MODEL=qwen3:8b   (must match a model from `ollama list`; pull with `ollama pull qwen3:8b`)
# Qwen3-family models on Ollama "think" (long chain-of-thought) before
# answering — slow for game chatter. Disable it:
# MIND_THINK=false
# Local models are slower than Gemini — raise the per-request timeout if needed:
# MIND_TIMEOUT_MS=60000
# Make sure the Ollama app (or `ollama serve`) is running before the director.
# Optional: override the blended $/1M-token rate the flight recorder uses for costUsd
# MIND_USD_PER_MTOKENS=
